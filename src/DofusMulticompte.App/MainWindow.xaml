<Window x:Class="DofusMulticompte.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DofusMulticompte.App.ViewModels"
        xmlns:controls="clr-namespace:DofusMulticompte.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Multicompte Dofus"
        Width="1240" Height="800" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="CharacterCard" DataType="{x:Type vm:CharacterViewModel}">
            <Border x:Name="card" Width="300" Margin="0,0,16,16" CornerRadius="8"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <!-- Aperçu en direct de la fenêtre : cliquer pour l'afficher -->
                    <Grid x:Name="preview" Height="169" Cursor="Hand" ToolTip="Afficher cette fenêtre">
                        <Grid.InputBindings>
                            <MouseBinding Gesture="LeftClick"
                                          Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>
                        </Grid.InputBindings>
                        <Border CornerRadius="7,7,0,0" Background="{StaticResource Surface2}"/>
                        <Image x:Name="thumb" Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                            <!-- Arrondit seulement les coins du haut : le rectangle déborde sous l'image. -->
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,298,190" RadiusX="7" RadiusY="7"/>
                            </Image.Clip>
                        </Image>
                        <TextBlock x:Name="noPreview" Text="Pas encore d'aperçu (fenêtre réduite ?)" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="8">
                            <Border Background="{StaticResource Accent}" CornerRadius="3" Padding="7,2" Margin="0,0,6,0"
                                    Visibility="{Binding IsLeader, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Meneur" Foreground="#1A1408" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                            <Border Background="{StaticResource Turn}" CornerRadius="3" Padding="7,2"
                                    Visibility="{Binding IsTurn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Son tour" Foreground="#0B2117" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                            <Border x:Name="offlineBadge" Background="{StaticResource Surface3}" CornerRadius="3" Padding="7,2" Visibility="Collapsed">
                                <TextBlock x:Name="offlineText" Text="Hors ligne" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                        </StackPanel>

                        <Button x:Name="forgetBtn" Content="Retirer" Padding="8,2" Margin="8" Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                ToolTip="Retirer ce personnage de la liste (ses réglages et son image sont supprimés)."
                                Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </Grid>

                    <StackPanel Margin="14,12,14,14">
                        <!-- Identité -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="6" Background="{Binding ClassBrush}" VerticalAlignment="Center"
                                    Cursor="Hand" ToolTip="Choisir l'image du personnage (découpée dans sa fenêtre)">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.ChooseAvatarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                <Grid>
                                    <TextBlock Text="{Binding ClassInitial}" FontSize="17" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Image du personnage (choisie, sinon tête de base de la classe) -->
                                    <Border CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ClassName}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Niv." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Width="46" Text="{Binding Level, UpdateSourceTrigger=LostFocus}" MaxLength="3"
                                         HorizontalContentAlignment="Center"
                                         ToolTip="Le client Dofus n'expose pas le niveau : saisis-le ici, il est mémorisé pour ce personnage."/>
                            </StackPanel>
                        </Grid>

                        <!-- Ce qui se passera à son tour -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AutomationSummary}" Margin="8,0,0,0" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox Content="Inclure dans les automatisations" Margin="0,10,0,0"
                                  IsChecked="{Binding IncludedInAutomation}" IsEnabled="{Binding IsConnected}"/>

                        <!-- Actions -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="leaderBtn" Content="Définir meneur"
                                    Command="{Binding DataContext.SetLeaderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button x:Name="passBtn" Grid.Column="2" Content="Passer le tour"
                                    ToolTip="Envoie tout de suite la touche « Passer son tour » à cette fenêtre (pour tester la configuration)."
                                    Command="{Binding DataContext.TestPassCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button x:Name="launchBtn" Grid.Column="2" Content="Lancer" Visibility="Collapsed"
                                    Background="{StaticResource AccentSoft}"
                                    ToolTip="Demande une instance à Ankama Launcher (compte actif du launcher). Connecte ensuite ce personnage dans la fenêtre qui s'ouvre."
                                    Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Grid.Column="4" Content="↑" Padding="9,5" ToolTip="Monter dans l'ordre de passage"
                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Grid.Column="6" Content="↓" Padding="9,5" ToolTip="Descendre dans l'ordre de passage"
                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Muted}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLeader}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter TargetName="leaderBtn" Property="Content" Value="Retirer meneur"/>
                    <Setter TargetName="leaderBtn" Property="Background" Value="{StaticResource AccentSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTurn}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Turn}"/>
                    <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AutomationSummary}" Value="Mis au premier plan à son tour">
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Turn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding WillAutoPass}" Value="True">
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Auto}"/>
                </DataTrigger>
                <!-- Personnage connu sans instance ouverte -->
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter TargetName="thumb" Property="Opacity" Value="0.35"/>
                    <Setter TargetName="preview" Property="Cursor" Value="Arrow"/>
                    <Setter TargetName="preview" Property="ToolTip" Value="Instance fermée"/>
                    <Setter TargetName="noPreview" Property="Text" Value="Aucune image enregistrée"/>
                    <Setter TargetName="offlineBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="forgetBtn" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="passBtn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="launchBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                    <Setter TargetName="offlineText" Property="Text" Value="Lancement…"/>
                    <Setter TargetName="offlineBadge" Property="Background" Value="{StaticResource AccentSoft}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Mode liste : une ligne compacte par personnage -->
        <DataTemplate x:Key="CharacterRow" DataType="{x:Type vm:CharacterViewModel}">
            <Border x:Name="row" Margin="0,0,16,6" CornerRadius="6" Padding="10,7"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Identité : cliquer pour afficher la fenêtre -->
                    <Grid x:Name="identity" Background="Transparent" Cursor="Hand" ToolTip="Afficher cette fenêtre">
                        <Grid.InputBindings>
                            <MouseBinding Gesture="LeftClick"
                                          Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="tile" Width="30" Height="30" CornerRadius="5" Background="{Binding ClassBrush}" VerticalAlignment="Center"
                                ToolTip="Choisir l'image du personnage (découpée dans sa fenêtre)">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.ChooseAvatarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                            <Grid>
                                <TextBlock Text="{Binding ClassInitial}" FontSize="14" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Image du personnage (choisie, sinon tête de base de la classe) -->
                                <Border CornerRadius="5" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ClassName}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- Badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource Accent}" CornerRadius="3" Padding="6,1" Margin="0,0,6,0"
                                Visibility="{Binding IsLeader, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Meneur" Foreground="#1A1408" FontWeight="SemiBold" FontSize="11"/>
                        </Border>
                        <Border Background="{StaticResource Turn}" CornerRadius="3" Padding="6,1" Margin="0,0,6,0"
                                Visibility="{Binding IsTurn, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Son tour" Foreground="#0B2117" FontWeight="SemiBold" FontSize="11"/>
                        </Border>
                        <Border x:Name="offlineBadge" Background="{StaticResource Surface3}" CornerRadius="3" Padding="6,1" Margin="0,0,6,0" Visibility="Collapsed">
                            <TextBlock x:Name="offlineText" Text="Hors ligne" FontWeight="SemiBold" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <!-- Ce qui se passera à son tour -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,10,0">
                        <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AutomationSummary}" Margin="8,0,0,0" Style="{StaticResource Hint}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Niveau et automatisations -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Niv." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Width="42" Text="{Binding Level, UpdateSourceTrigger=LostFocus}" MaxLength="3" Padding="4,2"
                                     HorizontalContentAlignment="Center"
                                     ToolTip="Le client Dofus n'expose pas le niveau : saisis-le ici, il est mémorisé pour ce personnage."/>
                        </StackPanel>
                        <CheckBox Content="Auto" Margin="12,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Inclure dans les automatisations"
                                  IsChecked="{Binding IncludedInAutomation}" IsEnabled="{Binding IsConnected}"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="leaderBtn" Content="Meneur" Padding="8,4" Margin="0,0,4,0" ToolTip="Définir comme meneur"
                                Command="{Binding DataContext.SetLeaderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button x:Name="passBtn" Content="Passer" Padding="8,4" Margin="0,0,4,0"
                                ToolTip="Envoie tout de suite la touche « Passer son tour » à cette fenêtre (pour tester la configuration)."
                                Command="{Binding DataContext.TestPassCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button x:Name="launchBtn" Content="Lancer" Padding="8,4" Margin="0,0,4,0" Visibility="Collapsed"
                                Background="{StaticResource AccentSoft}"
                                ToolTip="Demande une instance à Ankama Launcher (compte actif du launcher). Connecte ensuite ce personnage dans la fenêtre qui s'ouvre."
                                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button x:Name="forgetBtn" Content="Retirer" Padding="8,4" Margin="0,0,4,0" Visibility="Collapsed"
                                ToolTip="Retirer ce personnage de la liste (ses réglages et son image sont supprimés)."
                                Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="↑" Padding="8,4" Margin="0,0,4,0" ToolTip="Monter dans l'ordre de passage"
                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="↓" Padding="8,4" ToolTip="Descendre dans l'ordre de passage"
                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Muted}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLeader}" Value="True">
                    <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter TargetName="leaderBtn" Property="ToolTip" Value="Retirer le rôle de meneur"/>
                    <Setter TargetName="leaderBtn" Property="Background" Value="{StaticResource AccentSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTurn}" Value="True">
                    <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Turn}"/>
                    <Setter TargetName="row" Property="Background" Value="{StaticResource TurnSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AutomationSummary}" Value="Mis au premier plan à son tour">
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Turn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding WillAutoPass}" Value="True">
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Auto}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter TargetName="tile" Property="Opacity" Value="0.4"/>
                    <Setter TargetName="identity" Property="Cursor" Value="Arrow"/>
                    <Setter TargetName="identity" Property="ToolTip" Value="Instance fermée"/>
                    <Setter TargetName="offlineBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="forgetBtn" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="passBtn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="launchBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                    <Setter TargetName="offlineText" Property="Text" Value="Lancement…"/>
                    <Setter TargetName="offlineBadge" Property="Background" Value="{StaticResource AccentSoft}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Bouton d'un sélecteur Cartes / Liste -->
        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Colonne de réglages -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,22,24,24">
                    <TextBlock Text="Multicompte Dofus" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                    <TextBlock Text="AU DÉBUT DU TOUR D'UN PERSONNAGE" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>

                    <CheckBox IsChecked="{Binding BringTurnWindowToFront}">
                        <StackPanel>
                            <TextBlock Text="Mettre sa fenêtre au premier plan"/>
                            <TextBlock Text="La fenêtre du personnage qui doit jouer passe devant les autres."
                                       Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding AutoPassFollowers}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Passer le tour de tous, sauf le meneur"/>
                            <TextBlock Text="Pour chaque personnage inclus qui n'est pas le meneur." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding AutoPassLeader}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Passer aussi le tour du meneur"/>
                            <TextBlock Text="Au cas où : le meneur passe lui aussi son tour automatiquement."
                                       Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="HORS COMBAT" Style="{StaticResource SectionTitle}"/>
                    <CheckBox IsChecked="{Binding BringWindowOnAlert}">
                        <StackPanel>
                            <TextBlock Text="Afficher la fenêtre sur une demande d'échange"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Quand une fenêtre clignote hors combat (demande d'échange, invitation de groupe…), elle passe au premier plan au lieu d'être traitée comme un début de tour. Le combat est reconnu au bouton « FIN DE TOUR ». Active dans Dofus la notification externe des demandes d'échange."/>
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="PASSAGE DE TOUR" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="8"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Touche" VerticalAlignment="Center"/>
                        <controls:HotkeyBox Grid.Column="1" Text="{Binding PassTurnKey, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Text="Délai (ms)" VerticalAlignment="Center"/>
                        <Grid Grid.Row="2" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PassDelayMinMs, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" Padding="2,4"/>
                            <TextBlock Grid.Column="1" Text="à" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox Grid.Column="2" Text="{Binding PassDelayMaxMs, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" Padding="2,4"/>
                        </Grid>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="La touche doit correspondre au raccourci « Passer son tour » réglé dans Dofus (Options › Raccourcis). Le délai est tiré au hasard dans l'intervalle."/>

                    <CheckBox IsChecked="{Binding UseBackgroundInput}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Envoyer la touche en arrière-plan"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Expérimental : n'active pas la fenêtre, mais le client peut ignorer la touche. Désactivé, la fenêtre est activée un instant puis la main revient à la fenêtre précédente."/>
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="LANCEMENT" Style="{StaticResource SectionTitle}"/>
                    <CheckBox IsChecked="{Binding AutoEnterGame}">
                        <StackPanel>
                            <TextBlock Text="Entrer en jeu automatiquement"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Après un lancement depuis l'application, clique sur « Jouer » si le jeu s'arrête au choix du personnage. Sans effet sur les instances ouvertes autrement."/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding RelaunchStuckInstances}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Relancer les instances bloquées"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Si une instance lancée depuis l'application reste 15 s sur le fond de nuages sans liste de personnages, ou sur l'écran noir de démarrage, elle est fermée et relancée, jusqu'à ce que le chargement aboutisse."/>
                        </StackPanel>
                    </CheckBox>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding ShowConnectionNotifications}">
                            <StackPanel>
                                <TextBlock Text="Notifications de connexion"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                           Text="En bas à droite de l'écran : personnage en jeu, « x/N connectés », et chaque relance d'une connexion bloquée."/>
                            </StackPanel>
                        </CheckBox>
                        <Button Grid.Column="1" Content="Tester" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Top"
                                Command="{Binding TestNotificationCommand}"/>
                    </Grid>

                    <TextBlock Text="RACCOURCIS GLOBAUX" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="8"/>
                            <RowDefinition/>
                            <RowDefinition Height="8"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Suivant" VerticalAlignment="Center"/>
                        <controls:HotkeyBox AllowMouse="True" Grid.Column="1" Text="{Binding HotkeyNext, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Text="Précédent" VerticalAlignment="Center"/>
                        <controls:HotkeyBox AllowMouse="True" Grid.Row="2" Grid.Column="1" Text="{Binding HotkeyPrevious, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="4" Text="Meneur" VerticalAlignment="Center"/>
                        <controls:HotkeyBox AllowMouse="True" Grid.Row="4" Grid.Column="1" Text="{Binding HotkeyLeader, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <TextBlock Text="{Binding HotkeyStatus}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Personnage suivant, précédent, ou retour au meneur. Ils fonctionnent depuis n'importe quelle fenêtre et suivent l'ordre des cartes. Une touche seule, une combinaison, ou un bouton de souris : clique dans le champ puis appuie sur un bouton latéral (Souris4, Souris5) ou sur la molette. Un bouton de souris associé à un raccourci n'agit plus ailleurs (par exemple « Précédent » dans le navigateur)."/>

                    <TextBlock Text="CLIC SUR TOUTES LES FENÊTRES" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Raccourci" VerticalAlignment="Center"/>
                        <controls:HotkeyBox AllowMouse="True" Grid.Column="1" Text="{Binding HotkeyReplicateClick, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Clique à l'endroit pointé par le curseur dans la fenêtre de chaque personnage inclus dans les automatisations, puis dans la fenêtre de départ, qui reste devant. Pratique pour déplacer toute l'équipe ou parler à un PNJ. Le clic molette convient bien. Vide : désactivé."/>
                    <TextBlock Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Une seule action de ta part déclenche une action par personnage : c'est ce type de fonction qu'Ankama tolère le moins. À utiliser en connaissance de cause."/>

                    <TextBlock Text="BARRE DE PERSONNAGES" Style="{StaticResource SectionTitle}"/>
                    <CheckBox IsChecked="{Binding ShowCharacterBar}">
                        <StackPanel>
                            <TextBlock Text="Afficher la barre flottante"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Une icône par personnage en ligne, toujours visible par-dessus le jeu : un clic affiche sa fenêtre. Déplace-la en la faisant glisser par sa poignée."/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding CharacterBarVertical}" Margin="0,14,0,0" IsEnabled="{Binding ShowCharacterBar}">
                        <TextBlock Text="Barre verticale"/>
                    </CheckBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Personnages et journal -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="28,24,28,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- Sélecteur d'affichage -->
                    <Border CornerRadius="5" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="2" Margin="0,0,12,0"
                            Background="{StaticResource Surface}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Cartes" CommandParameter="Cards" Command="{Binding SetViewModeCommand}" ToolTip="Afficher les personnages en cartes, avec l'aperçu de la fenêtre">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Setter Property="Background" Value="{StaticResource Surface3}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CharacterListMode}" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Liste" CommandParameter="List" Command="{Binding SetViewModeCommand}" ToolTip="Afficher les personnages en liste compacte">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CharacterListMode}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Surface3}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Content="Lancer une instance" Padding="12,7" Margin="0,0,8,0"
                            ToolTip="Ouvre une nouvelle instance de Dofus via Ankama Launcher, sur le compte actif du launcher."
                            Command="{Binding LaunchNewCommand}"/>
                    <Button Content="{Binding LaunchAllLabel}" Padding="12,7" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                            ToolTip="Ouvre une instance pour chaque personnage hors ligne, l'une après l'autre."
                            Command="{Binding LaunchAllCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Personnages" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Clique sur un aperçu ou un nom pour afficher la fenêtre. L'ordre de la liste est l'ordre de passage des raccourcis."/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,12,0">
                <ItemsControl ItemsSource="{Binding Characters}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemTemplate" Value="{StaticResource CharacterCard}"/>
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CharacterListMode}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource CharacterRow}"/>
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCharacters}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Aucune instance de Dofus ouverte" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,0"
                           Text="Lance Dofus depuis Ankama Launcher : chaque instance apparaîtra ici dès son ouverture, puis affichera le pseudo et la classe une fois le personnage connecté."/>
            </StackPanel>

            <!-- Journal -->
            <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <Grid Margin="28,12,28,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Effacer" Padding="8,2" Command="{Binding ClearLogCommand}"/>
                        <TextBlock Text="JOURNAL" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Muted}" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
