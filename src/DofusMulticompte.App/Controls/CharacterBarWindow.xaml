<Window x:Class="DofusMulticompte.App.Controls.CharacterBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DofusMulticompte.App.ViewModels"
        Title="Barre de personnages"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" Foreground="{StaticResource Text}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalPanel">
            <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="BarItem" DataType="{x:Type vm:CharacterViewModel}">
            <Grid x:Name="item" Width="58" Margin="2" Background="Transparent" Cursor="Hand"
              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid.ToolTip>
                    <TextBlock>
                        <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="·"/>
                        <Run Text="{Binding ClassName, Mode=OneWay}"/>
                    </TextBlock>
                </Grid.ToolTip>
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Grid.InputBindings>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Choisir l'image…"
                                  Command="{Binding PlacementTarget.Tag.ChooseAvatarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <StackPanel>
                    <Grid Width="44" Height="44" HorizontalAlignment="Center">
                        <!-- Anneau : blanc pour la fenêtre active, vert pour le tour en cours -->
                        <Border x:Name="ring" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent"/>
                        <Border x:Name="tile" Margin="4" CornerRadius="6" Background="{Binding ClassBrush}">
                            <Grid>
                                <TextBlock Text="{Binding ClassInitial}" FontSize="17" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Image du personnage (choisie, sinon tête de base de la classe) -->
                                <Border CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Meneur -->
                        <Border Width="12" Height="12" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{StaticResource Accent}" BorderBrush="{StaticResource Bg}" BorderThickness="2"
                                Visibility="{Binding IsLeader, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <TextBlock x:Name="name" Text="{Binding DisplayName}" FontSize="10" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="56" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="item" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource Muted}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource Text}"/>
                    <Setter TargetName="name" Property="Foreground" Value="{StaticResource Text}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTurn}" Value="True">
                    <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource Turn}"/>
                    <Setter TargetName="name" Property="Foreground" Value="{StaticResource Turn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter TargetName="tile" Property="Opacity" Value="0.45"/>
                </DataTrigger>
                <!-- Barre verticale : colonne étroite, sans les noms (ils restent dans l'info-bulle) -->
                <DataTrigger Binding="{Binding DataContext.CharacterBarVertical, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="item" Property="Width" Value="44"/>
                    <Setter TargetName="item" Property="Margin" Value="0,1"/>
                    <Setter TargetName="name" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Marge : laisse la place à l'ombre portée -->
    <Border x:Name="Panel" Margin="8" CornerRadius="10" Background="#F0181C22" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel x:Name="Layout" Orientation="Horizontal">
            <!-- Poignée de déplacement -->
            <Border x:Name="Grip" Background="Transparent" Cursor="SizeAll" ToolTip="Glisser pour déplacer la barre"
                    Padding="4,6">
                <Path x:Name="GripDots" Fill="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Data="M0,0 h3 v3 h-3 z M0,6 h3 v3 h-3 z M0,12 h3 v3 h-3 z M5,0 h3 v3 h-3 z M5,6 h3 v3 h-3 z M5,12 h3 v3 h-3 z"/>
            </Border>
            <ItemsControl x:Name="Items" ItemTemplate="{StaticResource BarItem}" ItemsPanel="{StaticResource HorizontalPanel}"/>
        </StackPanel>
    </Border>
</Window>
